<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "VideoObject",
  "name": {{ product.title | append: " - Video" | json }},
  "description": {{ product.description | strip_html | truncate: 200 | json }},
  "thumbnailUrl": {{ media.preview_image | image_url: width: 800 | prepend: "https:" | json }},
  "uploadDate": {{ product.created_at | date: "%Y-%m-%dT%H:%M:%S%z" | json }},
  {%- if media.media_type == 'external_video' and media.host == 'youtube' -%}
    "embedUrl": {{ media.embed_url | json }},
    "contentUrl": {{ "https://www.youtube.com/watch?v=" | append: media.external_id | json }},
  {%- endif -%}
  "publisher": {
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | json }}
  }
}
</script>
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- comment -%} 
  FAQPage Schema - Add common FAQs for product pages
  These are brand-level FAQs that appear across product pages
{%- endcomment -%}
{%- comment -%} Related Products Schema for internal linking signals {%- endcomment -%}
{%- if request.page_type == 'product' and product and product.collections.first -%}
  {%- assign has_related = false -%}
  {%- for p in product.collections.first.products limit: 6 -%}
    {%- if p.id != product.id -%}
      {%- assign has_related = true -%}
      {%- break -%}
    {%- endif -%}
  {%- endfor -%}
  {%- if has_related -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Related Products",
  "description": {{ "Products related to " | append: product.title | json }},
  "itemListElement": [
    {%- assign position = 0 -%}
    {%- for related in product.collections.first.products limit: 6 -%}
      {%- if related.id != product.id and position < 5 -%}
        {%- assign position = position | plus: 1 -%}
        {%- if position > 1 -%},{%- endif -%}
      {
        "@type": "ListItem",
        "position": {{ position }},
        "item": {
          "@type": "Product",
          "name": {{ related.title | json }},
          "url": {{ related.url | prepend: shop.url | json }},
          {%- if related.featured_image -%}
            "image": {{ related.featured_image | image_url: width: 600 | prepend: "https:" | json }},
          {%- endif -%}
          "offers": {
            "@type": "Offer",
            "price": {{ related.price | divided_by: 100.0 | json }},
            "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
            "availability": "https://schema.org/{% if related.available %}InStock{% else %}OutOfStock{% endif %}"
          }
        }
      }
      {%- endif -%}
    {%- endfor -%}
  ]
}
</script>
  {%- endif -%}
{%- endif -%}

{%- if request.page_type == 'product' and product -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What makes Xinzuo kitchen knives different from other brands?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Xinzuo knives combine premium steels, precision forging, and ergonomic handles. Each series is tuned for a specific price and performance level—from everyday workhorse blades to flagship Damascus-clad knives—so home cooks and professionals can choose the right tool without paying legacy retail markups."
      }
    },
    {
      "@type": "Question",
      "name": "Are Xinzuo knives suitable for professional chefs and home cooks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Xinzuo offers knives for both home kitchens and professional use. Supreme and Retro series suit everyday cooking, while Mo and LAN series deliver premium steels, Damascus cladding, and longer edge retention for demanding prep work."
      }
    },
    {
      "@type": "Question",
      "name": "How should I care for and sharpen my Xinzuo knife?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Hand-wash with mild soap and dry immediately. Do not use a dishwasher. Store in a block, sheath, or magnetic holder. Hone regularly and sharpen with a whetstone or professional service to maintain edge performance."
      }
    },
    {
      "@type": "Question",
      "name": "What warranty does Xinzuo Australia provide?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Xinzuo knives include a lifetime warranty against manufacturing defects, such as blade or handle faults from production. Normal wear, misuse, and improper care are not covered. Purchases are also protected under Australian Consumer Law."
      }
    },
    {
      "@type": "Question",
      "name": "How long does delivery take in Australia?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Orders ship from Australia with tracking provided by email. Standard delivery typically takes 2 to 7 business days depending on location. Free standard shipping is available on orders over $100."
      }
    }
  ]
}
</script>
{%- endif -%}

