{%- comment -%} FAQPage Schema for Homepage FAQs {%- endcomment -%}
{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "@id": {{ shop.url | append: "#homepage-faq" | json }},
  "mainEntity": [
    {
      "@type": "Question",
      "name": "What is the difference between Xinzuo knife series?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Supreme Series offers dependable everyday knives. Retro Series holds a sharper edge longer. Mo Series adds genuine Damascus cladding. LAN Series is the flagship range with premium steels and refined balance for serious cooks and professionals."
      }
    },
    {
      "@type": "Question",
      "name": "Is the Damascus pattern on Mo and LAN series knives real?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Mo and LAN series knives use layered steel forged around a high-performance core, not a printed or laser-etched surface pattern. The cladding is structural and can help reduce food sticking during prep."
      }
    },
    {
      "@type": "Question",
      "name": "Can Xinzuo kitchen knives go in the dishwasher?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "No. Dishwashers can dull edges, damage handles, and may affect warranty coverage. Hand-wash with mild soap, dry immediately, and store in a block, sheath, or magnetic holder."
      }
    },
    {
      "@type": "Question",
      "name": "Where are Xinzuo kitchen knives made?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Xinzuo knives are manufactured in Yangjiang, China, with a knife-making heritage spanning more than 1,400 years. Xinzuo sells direct to Australian customers without legacy retail markups."
      }
    },
    {
      "@type": "Question",
      "name": "What warranty and returns does Xinzuo Australia offer?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Eligible orders include a 30-day change-of-mind return window and a lifetime warranty against manufacturing defects. Normal wear and misuse are not covered. Purchases are also protected under Australian Consumer Law."
      }
    }
  ]
}
</script>
{%- endif -%}
